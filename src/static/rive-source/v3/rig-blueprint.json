      { "name": "forearm_L", "parent": "upper_arm_L" },
      { "name": "upper_arm_R", "parent": "chest" },
      { "name": "forearm_R", "parent": "upper_arm_R" },
      { "name": "thigh_L", "parent": "hip" },
      { "name": "shin_L", "parent": "thigh_L" },
      { "name": "thigh_R", "parent": "hip" },
