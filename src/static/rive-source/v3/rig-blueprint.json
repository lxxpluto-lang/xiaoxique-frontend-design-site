      { "name": "eye_L", "parent": "bird_body" },
      { "name": "eye_R", "parent": "bird_body" }
    ]
  },
  "stateMachine": {
    "name": "Motion Machine",
    "inputs": [
      { "name": "play", "type": "boolean", "default": true },
      { "name": "replay", "type": "trigger" },
      { "name": "celebrate", "type": "trigger" },
      { "name": "reducedMotion", "type": "boolean", "default": false }
    ],
    "states": [
      { "name": "Idle", "animation": "idle" },
      { "name": "Main", "animation": "main_loop" },
      { "name": "Celebrate", "animation": "celebrate_once" },
      { "name": "Reduced", "animation": "reduced_loop" }
    ],
    "transitions": [
      { "from": "Idle", "to": "Main", "when": "play == true", "mixMs": 240 },
      { "from": "Main", "to": "Idle", "when": "play == false", "mixMs": 300 },
      { "from": "*", "to": "Main", "when": "replay fired", "mixMs": 90 },
      { "from": "*", "to": "Celebrate", "when": "celebrate fired", "mixMs": 120 },
      { "from": "Celebrate", "to": "Main", "when": "exit time 100%", "mixMs": 220 },
      { "from": "*", "to": "Reduced", "when": "reducedMotion == true", "mixMs": 200 }
    ]
  },
  "scenes": {
