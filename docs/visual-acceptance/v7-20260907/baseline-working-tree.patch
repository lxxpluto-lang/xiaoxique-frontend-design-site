+.selection-overview>view>text{display:block;font-size:25rpx;color:#42816a}
+.selection-overview>view>text:nth-child(2){font-size:55rpx;font-weight:750;color:#006e51}
+.selection-overview>view>text:nth-child(2)>text{font-size:24rpx;font-weight:400;margin-left:9rpx}
+.selection-overview>text{max-width:45%;font-size:25rpx;line-height:1.6;color:#43856d}
+.selection-tabs{width:100%;white-space:nowrap}
+.selection-tabs>view{display:flex;gap:10rpx}
+.selection-tabs button{display:inline-flex;min-height: 92rpx;padding:15rpx 22rpx;align-items:center;justify-content:center;font-size:26rpx;border-radius:999rpx;color:#4c7b64;background:#fff}
+.selection-tabs button.selected{background:var(--gradient-brand);color:#fff}
+.category-recommend__icon image{width:100%;height:240rpx}
+.selection-poster{width:118rpx;height:122rpx;border-radius:23rpx}
+.points-hero>image{position:absolute;right:12rpx;top:8rpx;width:250rpx;height:250rpx}
+.points-hero>text,.points-hero>view{position:relative}
+.milestone-card,.mem-card{padding:28rpx;border-radius:30rpx;background:#fff}
+.milestone-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-top:23rpx}
+.milestone-grid>view{display:flex;gap:12rpx;flex-direction:column;padding:20rpx 10rpx;border:1rpx solid #d5e8dd;border-radius:22rpx;text-align:center;background:#f4faf7}
+.milestone-grid>view>text:first-child{font-size:31rpx;font-weight:750;color:#42745e}
+.milestone-grid>view>text:nth-child(2){font-size:23rpx;line-height:1.5;color:#557164}
+.milestone-grid>view>text:last-child{font-size:23rpx;color:#5c6e63}
+.milestone-grid>view.reached{background:#def6e9;border-color:#67bb94}
+.mem-card>text{display:block;margin-top:18rpx;font-size:25rpx;line-height:1.6;color:#5d7e6c}
+.mem-card>view{display:grid;grid-template-columns:1fr 140rpx;gap:15rpx;margin-top:22rpx}
+.mem-card input{height:78rpx;padding:0 20rpx;border-radius:18rpx;background:#f0f7f3;font-size:27rpx}
+.mem-card button{display:flex;align-items:center;justify-content:center;border-radius:18rpx;background:var(--gradient-brand);color:#fff;font-size:28rpx}
+@media(prefers-reduced-motion:reduce){.prototype-shell *{animation-duration:.001ms;animation-iteration-count:1;transition-duration:.001ms;scroll-behavior:auto}}
