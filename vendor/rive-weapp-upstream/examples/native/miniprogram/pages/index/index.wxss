.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx 60rpx;
}

.hero {
  padding: 24rpx 8rpx 36rpx;
}
.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--accent);
  background: rgba(255, 91, 74, 0.12);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}
.hero-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--text-dim);
  line-height: 1.5;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.card {
  width: 48.5%;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.card-hover { transform: scale(0.98); opacity: 0.92; }

.card-art {
  position: relative;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-initial {
  font-size: 96rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}
.card-play {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}

.card-body { padding: 20rpx 22rpx 24rpx; }
.card-title { font-size: 30rpx; font-weight: 600; }
.card-sub { margin-top: 6rpx; font-size: 23rpx; color: var(--text-dim); }
.card-tags { margin-top: 16rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag {
  font-size: 20rpx;
  color: var(--text-dim);
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.tag-dim { opacity: 0.7; }

.footer {
  text-align: center;
  color: var(--text-dim);
  font-size: 22rpx;
  margin-top: 12rpx;
}
